# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI scratch
supabase/.temp/

# Money Pro import: generated personal-data artifacts (regenerable from the
# source CSVs via scripts/import/money-pro/01-consolidate.ts). Keep the scripts
# and mappings, but never commit the raw transaction dumps.
scripts/import/money-pro/data/

# Verified account balances live in a local-only file — never commit balances.
scripts/import/money-pro/mappings/balances.local.json
