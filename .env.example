# ── Supabase ────────────────────────────────────────────────────────────────
# Local dev: put the local-stack values (from `supabase status`) in .env.local;
# it overrides .env. Production (.env / Vercel env): the hosted project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — server-only (Telegram webhook). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram bot (Automation) ───────────────────────────────────────────────
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT the leading @ (used to build the t.me deep link).
TELEGRAM_BOT_USERNAME=
# Any long random string; sent by Telegram in the x-telegram-bot-api-secret-token
# header and verified by the webhook route. Register the webhook with:
#   npm run telegram:webhook -- --url https://<domain>/api/automation/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# ── Gemini (transaction extraction for the Telegram bot) ────────────────────
GEMINI_API_KEY=
