# ── Supabase ────────────────────────────────────────────────────────────────
# Local dev: put the local-stack values (from `supabase status`) in .env.local;
# it overrides .env. Production (.env / Vercel env): the hosted project values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key — server-only (Telegram webhook). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram bot (Automation) ───────────────────────────────────────────────
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT the leading @ (used to build the t.me deep link).
TELEGRAM_BOT_USERNAME=
# Any long random string; sent by Telegram in the x-telegram-bot-api-secret-token
# header and verified by the webhook route. Register the webhook with:
#   npm run telegram:webhook -- --url https://<domain>/api/automation/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# ── Gemini (Telegram bot: receipt extraction, wealth-manager agent, reports) ──
# When unset, plain-text Telegram messages fall back to transaction extraction.
GEMINI_API_KEY=
# Optional: model for the agent + reports (default gemini-3.8-flash).
# GEMINI_AGENT_MODEL=gemini-3.8-flash

# ── Daily cron (/api/cron/daily: balance snapshots + weekly/monthly reports) ─
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically when set.
CRON_SECRET=
# IANA timezone that decides "today", "Monday" and "1st of month" for reports.
REPORT_TIMEZONE=America/Santo_Domingo
